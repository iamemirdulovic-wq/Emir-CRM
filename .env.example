# ---------------------------------------------------------------------------
# Emir CRM — environment template. Copy to .env and fill in.
# Never commit a real .env. Every secret below stays out of version control.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
APP_URL=https://crm.example.ae
LOG_LEVEL=info

# --- Database (MySQL 8) ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=emir
DB_PASSWORD=
DB_NAME=emir_crm
DB_POOL_SIZE=10
# Alternatively a single URL: mysql://user:pass@host:3306/emir_crm
# DATABASE_URL=

# --- Security --------------------------------------------------------------
# 32 bytes, hex or base64. Generate: openssl rand -hex 32
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=emir_sid
# Set to true in production (HTTPS only).
# Required in production: the server refuses to start with it off, because the
# session cookie would then be sent over plain http.
COOKIE_SECURE=false
TRUST_PROXY=true

# --- Meta: Lead Ads + Conversions API --------------------------------------
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# --- WhatsApp --------------------------------------------------------------
# cloud = WhatsApp Cloud API (direct from Meta). wati / twilio = via a provider.
# log = nothing is sent; the message is only recorded.
WHATSAPP_PROVIDER=log
# In production the server refuses to start on the "log" provider unless this is
# set, because a CRM that silently swallows every message looks like it is
# working. Set it to 1 to run the CRM for calls, imports and email before
# WhatsApp is connected: sends are then recorded as failed and the inbox says
# "Not sent — WhatsApp is not connected yet."
ALLOW_FAKE_WHATSAPP=0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WATI_BASE_URL=
WATI_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Google Ads ------------------------------------------------------------
GOOGLE_LEAD_FORM_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_CONVERSION_ACTION=

# --- Website form ----------------------------------------------------------
WEBSITE_FORM_HMAC_SECRET=
RECAPTCHA_SECRET=

# --- Email (SMTP out, IMAP in) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Emir Real Estate <sales@example.ae>"
# Inbound replies arrive at reply+{conversation_id}@MAIL_REPLY_DOMAIN
MAIL_REPLY_DOMAIN=mail.example.ae
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# --- Push (Firebase Cloud Messaging) ---------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- AI (provider-agnostic) ------------------------------------------------
AI_PROVIDER=none
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Background worker -----------------------------------------------------
WORKER_ENABLED=true
# Run the worker inside the API process instead of beside it. Set this to 1 on
# managed Node hosting (Hostinger Cloud among others), which runs exactly one
# process per application and gives you no way to start a second. Without it the
# worker never runs, and the worker is what sends the welcome message inside
# thirty seconds, fires the follow-ups and checks the SLA.
WORKER_IN_PROCESS=0
WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=10
WORKER_ID=

# Bulk import file storage (local disk). Files are deleted once an import's
# 24-hour undo window closes, and abandoned uploads after a week.
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=64
