# ---------------------------------------------------------------------------
# Emir CRM — environment template. Copy to .env and fill in.
# Never commit a real .env. Every secret below stays out of version control.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# Bind address. Every interface is what managed hosting needs: the platform
# reaches the app through its own proxy, not over loopback, so a server
# listening only on 127.0.0.1 is one the platform reports as down. Set this to
# 127.0.0.1 only behind a reverse proxy on the same box.
HOST=0.0.0.0
# The address agents and clients open. Used in push deep links, offer links and
# brochure links, so a wrong value here sends people to the wrong place.
APP_URL=https://crm.example.ae
LOG_LEVEL=info

# --- Database (MySQL 8) ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=emir
DB_PASSWORD=
DB_NAME=emir_crm
DB_POOL_SIZE=10
# Alternatively a single URL: mysql://user:pass@host:3306/emir_crm
# DATABASE_URL=

# --- Security --------------------------------------------------------------
# 32 bytes, hex or base64. Generate: openssl rand -hex 32
# Encrypts API keys and tokens stored in the database.
#
# Optional. Leave it blank and the CRM creates its own on first use, at
# KEY_FILE — on disk, never in the database, readable only by the server. That
# is there so an owner on managed hosting, with no terminal, still gets their
# secrets encrypted: a key that can only be set through a control panel is one
# that never gets set, and then nothing is encrypted at all.
#
# Set it here and it wins. Either way, back up whichever one you use: lose it
# and anything encrypted with it has to be entered again.
ENCRYPTION_KEY=
KEY_FILE=./var/emir-crm.key
SESSION_COOKIE_NAME=emir_sid
# Set to true in production (HTTPS only).
# Required in production: the server refuses to start with it off, because the
# session cookie would then be sent over plain http.
COOKIE_SECURE=false
TRUST_PROXY=true

# --- Meta: Lead Ads + Conversions API --------------------------------------
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# --- WhatsApp --------------------------------------------------------------
# cloud = WhatsApp Cloud API (direct from Meta). wati / twilio = via a provider.
# log = nothing is sent; the message is only recorded.
WHATSAPP_PROVIDER=log
# In production the server refuses to start on the "log" provider unless this is
# set, because a CRM that silently swallows every message looks like it is
# working. Set it to 1 to run the CRM for calls, imports and email before
# WhatsApp is connected: sends are then recorded as failed and the inbox says
# "Not sent — WhatsApp is not connected yet."
ALLOW_FAKE_WHATSAPP=0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WATI_BASE_URL=
WATI_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Google Ads ------------------------------------------------------------
GOOGLE_LEAD_FORM_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_CONVERSION_ACTION=

# --- Website form ----------------------------------------------------------
WEBSITE_FORM_HMAC_SECRET=
RECAPTCHA_SECRET=
# The key the form on homes.me carries. It sits in the page source by nature,
# so it is not a secret — it is a name you can revoke. What protects a public
# endpoint is the rate limit, the honeypot, and being able to change this the
# day it starts being abused.
PUBLIC_SITE_KEY=
# property-investment.ae. Both of these can instead be set inside the CRM
# (Settings), where the secret is encrypted at rest. A value here wins, so an
# owner who prefers the hosting panel is never overridden from a screen.
PROPERTY_INVESTMENT_HMAC_SECRET=
PROPERTY_INVESTMENT_URL=

# --- Email (SMTP out, IMAP in) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Emir Real Estate <sales@example.ae>"
# Inbound replies arrive at reply+{conversation_id}@MAIL_REPLY_DOMAIN
MAIL_REPLY_DOMAIN=mail.example.ae

# Client email is off until you deliberately switch it on. With this 0
# everything upstream still runs — templates merge, messages are recorded,
# campaigns report — and nothing leaves the building. That is the right state
# while building against a live database full of real clients.
FEATURE_EMAIL_SENDING=0
# smtp | brevo | resend | none
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
RESEND_API_KEY=
# Secret the provider signs its open/click/bounce webhooks with.
EMAIL_WEBHOOK_SECRET=
# Test mode sends every client email to EMAIL_TEST_REDIRECT instead, with the
# real recipient in the subject — so the whole path can be exercised against a
# real provider without a client ever seeing it.
EMAIL_TEST_MODE=0
EMAIL_TEST_REDIRECT=

IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# --- Sign-in location (optional) -------------------------------------------
# Turns a sign-in IP into a city on the security screen. Leave it blank and
# sign-ins are simply recorded without a city, which every screen is written
# to read naturally. A MaxMind database means a licence, a download and a cron
# job, and the CRM must never need one to work.
MAXMIND_DB_PATH=

# --- Push (Firebase Cloud Messaging) ---------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# The browser half of Firebase. These four are public by design — they ship to
# every phone that opens the CRM, exactly as Google intends, and they are not
# secrets. What stops a stranger notifying your agents is FCM_PRIVATE_KEY
# above, which never leaves the server. FCM_VAPID_KEY is the "Web Push
# certificate" key pair in Firebase -> Cloud Messaging.
FCM_WEB_API_KEY=
FCM_WEB_APP_ID=
FCM_MESSAGING_SENDER_ID=
FCM_VAPID_KEY=

# --- AI (provider-agnostic) ------------------------------------------------
# Emir AI. Set AI_PROVIDER=gemini and paste a key to switch it on; until then
# every AI feature is simply off and nothing else changes.
#
# Use a key with billing enabled. On Google's free tier your prompts may be used
# to improve their models, and the prompts here contain real buyers' names,
# numbers and WhatsApp conversations.
AI_PROVIDER=none
# gemini-2.0-flash-lite is the cheapest and is enough for every feature here.
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=

# What the AI may cost in a calendar month, in US dollars. 0 means no ceiling.
# Checked before each request, not after — a limit that is checked afterwards
# has already spent the money. The spend so far is shown in Settings > Emir AI.
AI_MONTHLY_CAP_USD=5

# --- Background worker -----------------------------------------------------
WORKER_ENABLED=true
# Run the worker inside the API process instead of beside it. Set this to 1 on
# managed Node hosting (Hostinger Cloud among others), which runs exactly one
# process per application and gives you no way to start a second. Without it the
# worker never runs, and the worker is what sends the welcome message inside
# thirty seconds, fires the follow-ups and checks the SLA.
WORKER_IN_PROCESS=0
WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=10
WORKER_ID=

# Bulk import file storage (local disk). Files are deleted once an import's
# 24-hour undo window closes, and abandoned uploads after a week.
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=64

# Task attachments — photos, floor plans and PDFs dropped onto a task card.
# They live under UPLOAD_DIR/tasks, named after their row id rather than the
# name the uploader typed, and are only ever served to someone who can already
# see the task. Images and PDF only; SVG is refused because it can carry script.
MAX_ATTACHMENT_MB=10

# How long before a deadline the assigned user is emailed about it. A sweep runs
# every five minutes and claims each task before sending, so nobody is nudged
# twice and a task whose moment passed while the worker was down is still
# warned about — late, rather than not at all. Needs SMTP_HOST to be set.
TASK_REMINDER_MINUTES=30
