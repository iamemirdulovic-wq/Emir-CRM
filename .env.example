# ---------------------------------------------------------------------------
# Emir CRM — environment template. Copy to .env and fill in.
# Never commit a real .env. Every secret below stays out of version control.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
APP_URL=https://crm.example.ae
LOG_LEVEL=info

# --- Database (MySQL 8) ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=emir
DB_PASSWORD=
DB_NAME=emir_crm
DB_POOL_SIZE=10
# Alternatively a single URL: mysql://user:pass@host:3306/emir_crm
# DATABASE_URL=

# --- Security --------------------------------------------------------------
# 32 bytes, hex or base64. Generate: openssl rand -hex 32
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=emir_sid
# Set to true in production (HTTPS only).
COOKIE_SECURE=false
TRUST_PROXY=true

# --- Meta: Lead Ads + Conversions API --------------------------------------
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# --- WhatsApp --------------------------------------------------------------
# cloud = WhatsApp Cloud API (direct from Meta). log = write to the DB only.
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WATI_BASE_URL=
WATI_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Google Ads ------------------------------------------------------------
GOOGLE_LEAD_FORM_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_CONVERSION_ACTION=

# --- Website form ----------------------------------------------------------
WEBSITE_FORM_HMAC_SECRET=
RECAPTCHA_SECRET=

# --- Email (SMTP out, IMAP in) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Emir Real Estate <sales@example.ae>"
# Inbound replies arrive at reply+{conversation_id}@MAIL_REPLY_DOMAIN
MAIL_REPLY_DOMAIN=mail.example.ae
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# --- Push (Firebase Cloud Messaging) ---------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- AI (provider-agnostic) ------------------------------------------------
AI_PROVIDER=none
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Background worker -----------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=10
WORKER_ID=
