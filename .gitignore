# Uploaded import files. They are read back by the import job and deleted with
# the import; nothing here belongs in version control.
var/

# The encryption key the CRM creates for itself when ENCRYPTION_KEY is unset.
# Never committed: it protects the API keys stored in the database.
var/emir-crm.key
server/var/emir-crm.key
*.key

# Database dumps. They hold every client in the business; they never go in git.
*.sql.gz
crm-backups/
shots*/
web/dist-polish*/
/*.mjs
web/dist-*/
docs/v2/phone-proof/.shots*/

# Scratch scripts. Throwaway probes written while chasing one thing down live
# here rather than in the repository proper: they have no tests, no comments
# and a hard-coded port, and a committed one is read later as if it were a
# tool. The real ones have no leading dot.
scripts/.tmp-*
